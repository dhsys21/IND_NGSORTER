#include <vcl.h>
#pragma hdrstop
#include <stdio.h>
#include "../../ProductionHistory.h"
struct Check { bool Checked; Check() : Checked(false) {} };
struct Panel { UnicodeString Caption; };
struct Tray {
    int SLOT_COUNT;
    bool CELL_EXIST[96];
    AnsiString RANK[96], PICK[96];
};
struct Base { struct Config { bool useFatTestBarcodes; Config(): useFatTestBarcodes(false){} } config; };
Base base;
Base *BaseForm = &base;
class TMainForm {
public:
    bool productionSourceArmed, productionSourceCaptured, productionTestCycle;
    int productionSourceCells, productionSourceNg;
    AnsiString productionSourceTrayId;
    Tray tray_source;
    Panel panel;
    Panel *pTrayid_source;
    Check cycle, bypass;
    Check *cbCycle, *chkBypass;
    TMainForm() : productionSourceArmed(true), productionSourceCaptured(false),
        productionTestCycle(false), productionSourceCells(0), productionSourceNg(0) {
        pTrayid_source = &panel; cbCycle = &cycle; chkBypass = &bypass;
    }
    void memoMainLineAdd(AnsiString) {}
    void __fastcall BeginProductionSourceCycle();
    void __fastcall CaptureProductionSource();
    void __fastcall CompleteProductionSource();
};
// SOURCE_METHODS
static void Require(bool value) { if(!value) throw Exception("Source production assertion failed"); }
static TProductionBucket Totals() {
    std::vector<TProductionBucket> b = ProductionHistory().Query(ppDaily,Date());
    TProductionBucket total;
    for(unsigned int i=0;i<b.size();++i){
        total.Trays+=b[i].Trays; total.Cells+=b[i].Cells;
        total.Good+=b[i].Good; total.Bad+=b[i].Bad;
    }
    return total;
}
int WINAPI wWinMain(HINSTANCE,HINSTANCE,LPWSTR,int) {
    FILE *log=fopen("tmp/Access20261001/source-result.txt","w");
    try {
        TMainForm m;
        ProductionHistory().Initialize(ExpandFileName("tmp/Access20261001/source_"+IntToStr((int)GetCurrentProcessId())));
        m.BeginProductionSourceCycle();
        m.panel.Caption="SOURCE1";
        m.tray_source.SLOT_COUNT=96;
        for(int i=0;i<96;++i){
            m.tray_source.CELL_EXIST[i]=true;
            m.tray_source.RANK[i]=i<6?"NG":"OK";
            m.tray_source.PICK[i]=i<6?"Y":"N";
        }
        m.CaptureProductionSource();
        for(int i=0;i<6;++i){m.tray_source.CELL_EXIST[i]=false;m.tray_source.PICK[i]="N";}
        m.BeginProductionSourceCycle(); // Same physical tray, RESET/MANUAL retry.
        m.CaptureProductionSource();
        Require(m.productionSourceCells==96 && m.productionSourceNg==6);
        m.CompleteProductionSource();
        m.CompleteProductionSource();
        TProductionBucket b=Totals();
        Require(b.Trays==1 && b.Cells==96 && b.Good==90 && b.Bad==6);
        m.productionSourceArmed=true;
        m.BeginProductionSourceCycle();
        m.CaptureProductionSource(); // Same TrayId re-inserted, now 90 OK cells.
        m.CompleteProductionSource();
        b=Totals(); Require(b.Trays==2 && b.Cells==186 && b.Bad==6);
        m.productionSourceArmed=true;m.BeginProductionSourceCycle();
        m.cycle.Checked=true;m.CaptureProductionSource();m.cycle.Checked=false;
        m.CompleteProductionSource(); Require(Totals().Trays==2);
        m.productionSourceArmed=true;m.BeginProductionSourceCycle();m.CaptureProductionSource();
        m.panel.Caption="DIFFERENT";m.CompleteProductionSource();Require(Totals().Trays==2);
        fprintf(log,"PASS: incoming source counts survive pickup/reload; one count per physical cycle; no-NG tray; tests excluded; mismatched ID blocked.\n");
        fclose(log);return 0;
    }catch(Exception &e){fprintf(log,"FAIL: %s\n",AnsiString(e.Message).c_str());fclose(log);return 1;}
}
