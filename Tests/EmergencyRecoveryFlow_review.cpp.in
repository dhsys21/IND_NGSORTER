class AnsiString : public std::string {
public:
    AnsiString() {}
    AnsiString(const char* p):std::string(p){}
    AnsiString(const std::string& p):std::string(p){}
    bool IsEmpty() const {return empty();}
    AnsiString Trim() const {return *this;}
    int ToIntDef(int fallback) const {return empty()?fallback:std::atoi(c_str());}
};
AnsiString operator+(const AnsiString&a,const AnsiString&b){return AnsiString(std::string(a)+std::string(b));}
AnsiString operator+(const AnsiString&a,const char*b){return a+AnsiString(b);}
AnsiString operator+(const char*a,const AnsiString&b){return AnsiString(a)+b;}
AnsiString IntToStr(int n){char b[32];sprintf(b,"%d",n);return b;}
